// PullOverX 共享构建配置。
// 方案选择（roothide、rootless、rootful）由 build.sh 控制，如：./build.sh roothide

THEOS = /opt/theos
DEVKIT = $(SRCROOT)/roothide-devkit

// 默认方案；build.sh 会通过 xcodebuild 命令行覆盖。
POP_SCHEME = roothide
POP_SCHEME_LIBRARY_DIR = $(THEOS)/vendor/lib/iphone/roothide
POP_ALTLIST_FRAMEWORK_DIR = $(SRCROOT)/PullOverXPreferences/Frameworks/_roothide
POP_ROOTHIDE_LDFLAGS = -lroothide
POP_ROOTLESS_LDFLAGS =

SDKROOT = iphoneos
TARGETED_DEVICE_FAMILY = 1,2
IPHONEOS_DEPLOYMENT_TARGET = 14.0
ARCHS = arm64e
VALID_ARCHS = arm64 arm64e
ENABLE_BITCODE = NO
CLANG_ENABLE_OBJC_ARC = YES
ALWAYS_SEARCH_USER_PATHS = NO
GCC_PRECOMPILE_PREFIX_HEADER = YES
VERSIONING_SYSTEM = apple-generic
DYLIB_COMPATIBILITY_VERSION = 1
DYLIB_CURRENT_VERSION = 1

CODE_SIGN_IDENTITY =
CODE_SIGN_IDENTITY[sdk=iphoneos*] =
CODE_SIGNING_REQUIRED = NO
CODE_SIGNING_ALLOWED = NO
CODE_SIGN_STYLE = Manual
DEVELOPMENT_TEAM =
PROVISIONING_PROFILE_SPECIFIER =
AD_HOC_CODE_SIGNING_ALLOWED = YES

HEADER_SEARCH_PATHS = $(inherited) $(DEVKIT) $(THEOS)/vendor/include $(THEOS)/include

FRAMEWORK_SEARCH_PATHS = $(inherited) $(POP_SCHEME_LIBRARY_DIR) $(POP_ALTLIST_FRAMEWORK_DIR) $(THEOS)/vendor/lib
LIBRARY_SEARCH_PATHS = $(inherited) $(POP_SCHEME_LIBRARY_DIR) $(DEVKIT)/roothide $(THEOS)/vendor/lib

POP_SCHEME_DEFS = THEOS_PACKAGE_SCHEME_ROOTHIDE=1
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) $(POP_SCHEME_DEFS)

OTHER_LDFLAGS = $(inherited) -undefined dynamic_lookup -Wl,-w

GCC_GENERATE_DEBUGGING_SYMBOLS = NO
GCC_SYMBOLS_PRIVATE_EXTERN = YES
DEPLOYMENT_POSTPROCESSING = YES
COPY_PHASE_STRIP = NO
DEAD_CODE_STRIPPING = YES
